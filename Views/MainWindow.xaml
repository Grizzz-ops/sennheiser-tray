<Window x:Class="SennheiserTray.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:SennheiserTray"
        Title="Sennheiser Control"
        Icon="pack://application:,,,/SennheiserTray;component/Assets/SennheiserTray.ico"
        Width="360" Height="540" MinWidth="320" MinHeight="460"
        WindowStyle="None" ResizeMode="NoResize"
        AllowsTransparency="True" Background="Transparent"
        Topmost="True" ShowInTaskbar="True"
        FontFamily="Segoe UI Variable, Segoe UI">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
    </Window.Resources>
    <Window.InputBindings>
        <KeyBinding Key="Escape" Command="{Binding CloseDrawerCommand}"/>
        <KeyBinding Key="T" Modifiers="Control" Command="{Binding OpenTuneCommand}"/>
    </Window.InputBindings>

    <Grid Margin="8">
        <Border Background="{DynamicResource AppBackgroundBrush}"
                CornerRadius="16" IsHitTestVisible="False">
            <Border.Effect>
                <DropShadowEffect BlurRadius="18" ShadowDepth="0" Opacity="0.28"/>
            </Border.Effect>
        </Border>
        <Border Background="{DynamicResource AppBackgroundBrush}"
                BorderBrush="{DynamicResource ControlBorderBrush}" BorderThickness="1"
                CornerRadius="16" ClipToBounds="True">
          <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="38"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Margin="16,8,16,2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Image Grid.Column="0" Source="pack://application:,,,/SennheiserTray;component/Assets/SennheiserTray.png"
                       Width="24" Height="24" Stretch="Uniform" Margin="0,0,9,0"
                       VerticalAlignment="Center"
                       AutomationProperties.Name="Sennheiser headset widget icon"/>
                <Ellipse Grid.Column="1" Width="8" Height="8" Fill="{Binding ConnectionBrush}"
                         VerticalAlignment="Center" Margin="0,0,9,0"/>
                <TextBlock Grid.Column="2" Text="{Binding HeaderText}"
                           Foreground="{Binding StatusForeground}" FontSize="12"
                           FontWeight="SemiBold" VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis"/>
                <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center"
                            Margin="8,0"
                            Visibility="{Binding IsConnected, Converter={StaticResource BooleanToVisibilityConverter}}"
                            ToolTip="{Binding BatteryToolTip}">
                    <TextBlock Text="⚡" Foreground="{DynamicResource AccentBrush}" FontSize="11"
                               FontWeight="Bold" Margin="0,0,3,0"
                               Visibility="{Binding IsChargingInferred, Converter={StaticResource BooleanToVisibilityConverter}}"
                               AutomationProperties.Name="Charging inferred from battery trend"/>
                    <TextBlock Text="{Binding BatteryText}" Foreground="{DynamicResource TextMutedBrush}"
                               FontSize="11" VerticalAlignment="Center"/>
                </StackPanel>
                <Button Grid.Column="4" Content="Connect" Command="{Binding ConnectCommand}"
                        Style="{StaticResource ActionButtonStyle}" Padding="8,4"
                        Visibility="{Binding IsDisconnected, Converter={StaticResource BooleanToVisibilityConverter}}"/>
            </Grid>

            <Grid Grid.Row="1">
                <Grid x:Name="HomeScreen" Margin="10,0,10,8"
                      IsEnabled="{Binding CanChangeMode}"
                      Visibility="{Binding IsHomeScreenVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="42"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="28"/>
                        <RowDefinition Height="40"/>
                    </Grid.RowDefinitions>

                    <ItemsControl Grid.Row="0" ItemsSource="{Binding ModeChipItems}"
                                  VerticalAlignment="Center">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid Columns="5" Rows="1"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <ToggleButton Style="{StaticResource ModeChipStyle}"
                                                  IsChecked="{Binding IsSelected, Mode=OneWay}"
                                                  Command="{Binding DataContext.SelectModeCommand, RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
                                                  CommandParameter="{Binding Id}"
                                                  AutomationProperties.Name="{Binding Name}">
                                        <StackPanel>
                                            <TextBlock Text="{Binding Icon}"
                                                       FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                                       FontSize="16" HorizontalAlignment="Center"/>
                                            <TextBlock Text="{Binding Name}" FontSize="11"
                                                       HorizontalAlignment="Center"/>
                                        </StackPanel>
                                    </ToggleButton>
                                    <Button x:Name="ModePinButton" Grid.ZIndex="1" Width="18" Height="18" Padding="0"
                                            HorizontalAlignment="Right" VerticalAlignment="Top"
                                            Margin="0,0,1,1" Content="&#xE840;"
                                            FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                            Style="{StaticResource ModePinButtonStyle}"
                                            Visibility="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType={x:Type Grid}}, Converter={StaticResource BooleanToVisibilityConverter}}"
                                            ToolTip="{Binding DataContext.ModePinText, RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
                                            Command="{Binding DataContext.ToggleModePinCommand, RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
                                            AutomationProperties.Name="{Binding DataContext.ModePinActionText, RelativeSource={RelativeSource AncestorType={x:Type Window}}}"/>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <local:OrbControl Grid.Row="1" Width="310" Height="310"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Center"
                                      Level="{Binding AncLevel, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                      Label="{Binding OrbLabel}"
                                      AudioLevel="{Binding AudioLevel}"
                                      IsReadOnly="{Binding IsAdaptiveAnc}"
                                      IsConnected="{Binding IsConnected}"
                                      IsCallsMode="{Binding IsCallsMode}"
                                      IsMicrophoneMuted="{Binding IsMicrophoneMuted}"
                                      IsFocusBreak="{Binding IsFocusBreak}"
                                      LevelCommand="{Binding OrbLevelChangedCommand}"
                                      ToggleCommand="{Binding ToggleOrbCommand}"/>

                    <Button Grid.Row="2" Content="Adaptive"
                            Command="{Binding AdaptiveAncCommand}"
                            HorizontalAlignment="Center" VerticalAlignment="Center"
                            Padding="14,5" FontSize="11"
                            Style="{StaticResource AdaptivePillStyle}"
                            AutomationProperties.Name="Toggle Adaptive noise cancellation"/>

                    <Grid Grid.Row="3">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="0" Content="Tune" Command="{Binding OpenTuneCommand}"
                                Style="{StaticResource ActionButtonStyle}" Margin="0,0,5,0"/>
                        <Button Grid.Column="1" Content="Lab" Command="{Binding OpenLabCommand}"
                                Style="{StaticResource ActionButtonStyle}" Margin="5,0"/>
                    </Grid>
                </Grid>

                <Border x:Name="TuneDrawer" Style="{StaticResource TuneDrawerPanelStyle}"
                        Margin="0" Background="{DynamicResource AppBackgroundBrush}">
                    <ScrollViewer VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled" Padding="14,6,14,12"
                                  Margin="0,0,4,0">
                        <StackPanel>
                            <DockPanel Margin="0,0,0,12">
                                <Button Content="Back" Command="{Binding CloseDrawerCommand}"
                                        Style="{StaticResource ActionButtonStyle}" DockPanel.Dock="Right"/>
                                <Button Content="Reset flat" Command="{Binding ResetEqCommand}"
                                        Style="{StaticResource ActionButtonStyle}" DockPanel.Dock="Right"
                                        Margin="8,0,0,0"/>
                                <TextBlock Text="Tune" Foreground="{DynamicResource TextPrimaryBrush}"
                                           FontSize="20" FontWeight="SemiBold" VerticalAlignment="Center"/>
                            </DockPanel>

                            <Border Background="{DynamicResource EqGraphBackgroundBrush}" BorderThickness="0"
                                    CornerRadius="8" Padding="4" Margin="0,0,0,8">
                                <local:EqGraphControl Values="{Binding EqValues}"
                                                      AccentBrush="{DynamicResource AccentBrush}" Height="110"/>
                            </Border>
                            <Grid Margin="3,0,3,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition/><ColumnDefinition/><ColumnDefinition/>
                                    <ColumnDefinition/><ColumnDefinition/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="50 Hz" Foreground="{DynamicResource EqGraphLabelBrush}" FontSize="11" TextAlignment="Center"/>
                                <TextBlock Grid.Column="1" Text="250 Hz" Foreground="{DynamicResource EqGraphLabelBrush}" FontSize="11" TextAlignment="Center"/>
                                <TextBlock Grid.Column="2" Text="800 Hz" Foreground="{DynamicResource EqGraphLabelBrush}" FontSize="11" TextAlignment="Center"/>
                                <TextBlock Grid.Column="3" Text="3 kHz" Foreground="{DynamicResource EqGraphLabelBrush}" FontSize="11" TextAlignment="Center"/>
                                <TextBlock Grid.Column="4" Text="8 kHz" Foreground="{DynamicResource EqGraphLabelBrush}" FontSize="11" TextAlignment="Center"/>
                            </Grid>

                            <TextBlock Text="−6 to +6 dB" Foreground="{DynamicResource TextMutedBrush}"
                                       FontSize="11" HorizontalAlignment="Right" Margin="0,0,2,2"/>
                            <DockPanel Margin="0,3">
                                <TextBlock Text="Bass" Foreground="{DynamicResource EqBandLabelBrush}" Width="64" FontSize="12" VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding Eq1Text}" Foreground="{DynamicResource AccentBrush}" Width="48" DockPanel.Dock="Right" TextAlignment="Right" FontSize="11" VerticalAlignment="Center"/>
                                <Slider Minimum="-60" Maximum="60" Value="{Binding EqValues[0], Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" TickFrequency="5" IsSnapToTickEnabled="True" Style="{StaticResource EqSliderStyle}"/>
                            </DockPanel>
                            <DockPanel Margin="0,3">
                                <TextBlock Text="Low mid" Foreground="{DynamicResource EqBandLabelBrush}" Width="64" FontSize="12" VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding Eq2Text}" Foreground="{DynamicResource AccentBrush}" Width="48" DockPanel.Dock="Right" TextAlignment="Right" FontSize="11" VerticalAlignment="Center"/>
                                <Slider Minimum="-60" Maximum="60" Value="{Binding EqValues[1], Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" TickFrequency="5" IsSnapToTickEnabled="True" Style="{StaticResource EqSliderStyle}"/>
                            </DockPanel>
                            <DockPanel Margin="0,3">
                                <TextBlock Text="Mid" Foreground="{DynamicResource EqBandLabelBrush}" Width="64" FontSize="12" VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding Eq3Text}" Foreground="{DynamicResource AccentBrush}" Width="48" DockPanel.Dock="Right" TextAlignment="Right" FontSize="11" VerticalAlignment="Center"/>
                                <Slider Minimum="-60" Maximum="60" Value="{Binding EqValues[2], Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" TickFrequency="5" IsSnapToTickEnabled="True" Style="{StaticResource EqSliderStyle}"/>
                            </DockPanel>
                            <DockPanel Margin="0,3">
                                <TextBlock Text="High mid" Foreground="{DynamicResource EqBandLabelBrush}" Width="64" FontSize="12" VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding Eq4Text}" Foreground="{DynamicResource AccentBrush}" Width="48" DockPanel.Dock="Right" TextAlignment="Right" FontSize="11" VerticalAlignment="Center"/>
                                <Slider Minimum="-60" Maximum="60" Value="{Binding EqValues[3], Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" TickFrequency="5" IsSnapToTickEnabled="True" Style="{StaticResource EqSliderStyle}"/>
                            </DockPanel>
                            <DockPanel Margin="0,3,0,8">
                                <TextBlock Text="Treble" Foreground="{DynamicResource EqBandLabelBrush}" Width="64" FontSize="12" VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding Eq5Text}" Foreground="{DynamicResource AccentBrush}" Width="48" DockPanel.Dock="Right" TextAlignment="Right" FontSize="11" VerticalAlignment="Center"/>
                                <Slider Minimum="-60" Maximum="60" Value="{Binding EqValues[4], Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" TickFrequency="5" IsSnapToTickEnabled="True" Style="{StaticResource EqSliderStyle}"/>
                            </DockPanel>

                            <Grid Margin="0,5,0,5">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="8"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Button Grid.Column="0" Content="{Binding BassBoostText}"
                                        Command="{Binding BassBoostCommand}"
                                        IsEnabled="{Binding CanToggleBassBoost}"
                                        Style="{StaticResource ActionButtonStyle}"/>
                                <Button Grid.Column="2" Content="{Binding BassImpactText}"
                                        Command="{Binding BassImpactCommand}"
                                        Style="{StaticResource ActionButtonStyle}"/>
                            </Grid>
                            <TextBlock Text="Bass Impact boosts headset DSP and EQ; it does not create physical vibration."
                                       Foreground="{DynamicResource TextMutedBrush}" FontSize="11"
                                       TextWrapping="Wrap" Margin="0,4,0,8"/>
                            <Button Content="Restore previous mode" Command="{Binding RestorePreviousModeCommand}"
                                    IsEnabled="{Binding CanRestorePreviousMode}"
                                    Style="{StaticResource ActionButtonStyle}" HorizontalAlignment="Left"
                                    Margin="0,4,0,0"/>
                        </StackPanel>
                    </ScrollViewer>
                </Border>

                <Border x:Name="LabDrawer" Style="{StaticResource LabDrawerPanelStyle}"
                        Margin="0" Background="{DynamicResource AppBackgroundBrush}">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="14,6,14,12">
                        <StackPanel>
                            <DockPanel Margin="0,0,0,14">
                                <Button Content="Back" Command="{Binding CloseDrawerCommand}"
                                        Style="{StaticResource ActionButtonStyle}" DockPanel.Dock="Right"/>
                                <TextBlock Text="Lab" Foreground="{DynamicResource TextPrimaryBrush}"
                                           FontSize="20" FontWeight="SemiBold" VerticalAlignment="Center"/>
                            </DockPanel>
                            <Border Background="{DynamicResource SurfaceBrush}" CornerRadius="10"
                                    Padding="12" Margin="0,0,0,16">
                                <StackPanel>
                                    <TextBlock Text="BATTERY LIFE" Foreground="{DynamicResource AccentBrush}"
                                               FontSize="11" FontWeight="Bold"/>
                                    <TextBlock Text="{Binding BatteryText}" Foreground="{DynamicResource TextPrimaryBrush}"
                                               FontSize="16" FontWeight="SemiBold" Margin="0,5,0,2"/>
                                    <TextBlock Text="{Binding BatteryEstimateStatus}"
                                               Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11"
                                               TextWrapping="Wrap"/>
                                    <TextBlock Text="Approximate estimate from recent battery changes. Keep the app connected; battery health and charging control are not available."
                                               Foreground="{DynamicResource TextMutedBrush}" FontSize="11"
                                               TextWrapping="Wrap" Margin="0,5,0,0"/>
                                </StackPanel>
                            </Border>
                            <TextBlock Text="ADAPTIVE EQ" Foreground="{DynamicResource AccentBrush}" FontSize="11" FontWeight="Bold"/>
                            <TextBlock Text="Learns a steady profile from Windows playback, locally."
                                       Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11"
                                       TextWrapping="Wrap" Margin="0,4,0,10"/>
                            <Button Content="{Binding AdaptiveEqButtonText}" Command="{Binding AdaptiveEqCommand}"
                                    Style="{StaticResource ActionButtonStyle}" HorizontalAlignment="Left"/>
                            <TextBlock Text="{Binding AdaptiveEqStatus}"
                                       Foreground="{Binding AdaptiveEqStatusForeground}" FontSize="11"
                                       TextWrapping="Wrap" Margin="0,8,0,16"/>
                            <StackPanel Visibility="{Binding IsCallsMode, Converter={StaticResource BooleanToVisibilityConverter}}"
                                        Margin="0,0,0,14">
                                <TextBlock Text="CALLS" Foreground="{DynamicResource AccentBrush}"
                                           FontSize="11" FontWeight="Bold" Margin="0,0,0,6"/>
                                <Button Content="{Binding MicrophoneMuteText}"
                                        Command="{Binding ToggleMicrophoneMuteCommand}"
                                        ToolTip="{Binding MicrophoneMuteHotkeyStatus}"
                                        Style="{StaticResource ActionButtonStyle}"
                                        HorizontalAlignment="Left"/>
                                <TextBlock Text="{Binding MicrophoneMuteHotkeyStatus}"
                                           Foreground="{DynamicResource TextMutedBrush}"
                                           FontSize="11" Margin="0,5,0,0"/>
                            </StackPanel>
                            <StackPanel Visibility="{Binding IsGamingHintVisible, Converter={StaticResource BooleanToVisibilityConverter}}"
                                        Margin="0,0,0,14">
                                <DockPanel>
                                    <Button Content="Dismiss" Command="{Binding DismissGamingHintCommand}"
                                            Style="{StaticResource ActionButtonStyle}" Padding="7,4"
                                            DockPanel.Dock="Right" AutomationProperties.Name="Dismiss gaming latency hint"/>
                                    <TextBlock Text="Gaming connection" Foreground="{DynamicResource AccentBrush}"
                                               FontSize="11" FontWeight="Bold" VerticalAlignment="Center"/>
                                </DockPanel>
                                <TextBlock Text="Bluetooth adds latency. For the lowest delay use a wired or dongle connection."
                                           Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12"
                                           TextWrapping="Wrap" Margin="0,5,0,0"/>
                            </StackPanel>
                            <StackPanel Visibility="{Binding IsFocusMode, Converter={StaticResource BooleanToVisibilityConverter}}"
                                        Margin="0,0,0,14">
                                <TextBlock Text="FOCUS CYCLE" Foreground="{DynamicResource AccentBrush}"
                                           FontSize="11" FontWeight="Bold" Margin="0,0,0,6"/>
                                <Button Content="{Binding FocusCycleButtonText}" Command="{Binding FocusCycleCommand}"
                                        Style="{StaticResource ActionButtonStyle}" HorizontalAlignment="Left"/>
                                <TextBlock Text="{Binding FocusCycleStatus}"
                                           Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11"
                                           Margin="0,5,0,0"/>
                            </StackPanel>
                            <TextBlock Text="LAST COMMAND" Foreground="{DynamicResource TextMutedBrush}"
                                       FontSize="11" FontWeight="Bold" Margin="0,0,0,5"/>
                            <TextBlock Text="{Binding LastCommand}" Foreground="{DynamicResource StatusCommandBrush}"
                                       FontFamily="Consolas" FontSize="11"
                                       TextWrapping="Wrap" Margin="0,0,0,16"/>
                            <TextBlock Text="SETTINGS" Foreground="{DynamicResource TextSecondaryBrush}"
                                       FontSize="11" FontWeight="Bold" Margin="0,0,0,6"/>
                            <TextBlock Text="Appearance" Foreground="{DynamicResource TextPrimaryBrush}"
                                       FontSize="12" Margin="0,0,0,2"/>
                            <Button Content="{Binding ThemeToggleText}" Command="{Binding ToggleThemeCommand}"
                                    Style="{StaticResource ActionButtonStyle}"
                                    HorizontalAlignment="Left" Margin="0,0,0,12"/>
                            <CheckBox Content="Connect automatically when headset is available"
                                      IsChecked="{Binding IsAutoConnectEnabled, Mode=TwoWay}"
                                      Foreground="{DynamicResource TextPrimaryBrush}"
                                      FontSize="11" Margin="0,0,0,8"/>
                            <CheckBox Content="Launch with Windows"
                                      IsChecked="{Binding IsLaunchOnStartup, Mode=TwoWay}"
                                      Foreground="{DynamicResource TextPrimaryBrush}"
                                      FontSize="11" Margin="0,0,0,14"/>
                            <TextBlock Text="Global microphone mute shortcut"
                                       Foreground="{DynamicResource TextPrimaryBrush}"
                                       FontSize="12" Margin="0,0,0,4"/>
                            <ComboBox ItemsSource="{Binding MuteHotkeyChoices}"
                                      SelectedItem="{Binding MuteHotkeyKey, Mode=TwoWay}"
                                      ToolTip="Uses Ctrl+Shift plus the selected key"/>
                            <TextBlock Text="Choose another key if the shortcut is already in use."
                                       Foreground="{DynamicResource TextMutedBrush}"
                                       FontSize="11" TextWrapping="Wrap" Margin="0,4,0,14"/>
                            <TextBlock Text="Windows output volume" Foreground="{DynamicResource TextPrimaryBrush}"
                                       FontSize="12" Margin="0,0,0,2"/>
                            <DockPanel Margin="0,0,0,8">
                                <TextBlock Text="{Binding PlaybackVolume, StringFormat={}{0}%}"
                                           Foreground="{DynamicResource AccentBrush}" Width="38"
                                           DockPanel.Dock="Right" TextAlignment="Right"
                                           VerticalAlignment="Center" FontSize="11"/>
                                <Slider Minimum="0" Maximum="100" Value="{Binding PlaybackVolume, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                        IsEnabled="{Binding IsPlaybackVolumeAvailable}"
                                        ToolTip="{Binding PlaybackVolumeStatus}"
                                        Style="{StaticResource GlowSliderStyle}"/>
                            </DockPanel>
                            <TextBlock Text="{Binding PlaybackVolumeStatus}"
                                       Foreground="{DynamicResource TextMutedBrush}" FontSize="11"
                                       TextWrapping="Wrap" Margin="0,0,0,12"/>
                            <TextBlock Text="Headset" Foreground="{DynamicResource TextPrimaryBrush}"
                                       FontSize="12" Margin="0,0,0,5"/>
                            <ComboBox ItemsSource="{Binding Devices}" SelectedValue="{Binding SelectedDeviceId, Mode=TwoWay}"
                                      DisplayMemberPath="Name" SelectedValuePath="Id" Height="32"
                                      ToolTip="Select the paired Sennheiser control device"/>
                            <Button Content="{Binding ConnectButtonText}" Command="{Binding ConnectCommand}"
                                    Style="{StaticResource ActionButtonStyle}" HorizontalAlignment="Left"
                                    Margin="0,8,0,0"/>
                            <TextBlock Text="Playback analysis uses Windows loopback locally; no microphone capture or network access."
                                       Foreground="{DynamicResource TextMutedBrush}" FontSize="11"
                                       TextWrapping="Wrap" Margin="0,14,0,0"/>
                        </StackPanel>
                    </ScrollViewer>
                </Border>
            </Grid>
          </Grid>
        </Border>
    </Grid>
</Window>
