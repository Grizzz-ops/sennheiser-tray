<UserControl x:Class="SennheiserTray.EqGraphControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             MinHeight="110">
    <Canvas x:Name="GraphCanvas" Height="110" ClipToBounds="True"
            SizeChanged="GraphCanvas_SizeChanged"
            MouseLeftButtonDown="GraphCanvas_MouseLeftButtonDown"
            MouseMove="GraphCanvas_MouseMove"
            MouseLeftButtonUp="GraphCanvas_MouseLeftButtonUp"
            MouseLeave="GraphCanvas_MouseLeave"/>
</UserControl>
