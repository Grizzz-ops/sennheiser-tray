<UserControl x:Class="SennheiserTray.OrbControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Width="310" Height="310"
             AutomationProperties.Name="Noise and awareness control">
    <Canvas x:Name="DialCanvas" Width="310" Height="310"
            Background="Transparent"
            MouseLeftButtonDown="DialCanvas_MouseLeftButtonDown"
            MouseMove="DialCanvas_MouseMove"
            MouseLeftButtonUp="DialCanvas_MouseLeftButtonUp"
            MouseLeave="DialCanvas_MouseLeave">
        <Ellipse x:Name="ModeRing" Width="284" Height="284" Canvas.Left="13" Canvas.Top="13"
                 Stroke="{DynamicResource AccentBrush}" StrokeThickness="1.2"
                 Opacity="0.22" IsHitTestVisible="False"/>
        <Path x:Name="LevelArcGlow" Stroke="{DynamicResource AccentBrush}"
              Opacity="0.22" StrokeThickness="12" StrokeStartLineCap="Round"
              StrokeEndLineCap="Round" IsHitTestVisible="False"/>
        <Path x:Name="LevelArc" Stroke="{DynamicResource AccentBrush}"
              StrokeThickness="3.2" StrokeStartLineCap="Round"
              StrokeEndLineCap="Round" IsHitTestVisible="False"/>
        <Ellipse x:Name="DialThumb" Width="14" Height="14"
                 Fill="{DynamicResource AccentBrush}" Stroke="{DynamicResource AppBackgroundBrush}"
                 StrokeThickness="1.5" IsHitTestVisible="False"
                 RenderTransformOrigin="0.5,0.5">
            <Ellipse.RenderTransform>
                <ScaleTransform x:Name="DialThumbScale" ScaleX="1" ScaleY="1"/>
            </Ellipse.RenderTransform>
        </Ellipse>
        <Ellipse x:Name="OrbGlow" Width="222" Height="222"
                 Canvas.Left="44" Canvas.Top="44" Opacity="0.2"
                 RenderTransformOrigin="0.5,0.5" IsHitTestVisible="False">
            <Ellipse.Fill>
                <RadialGradientBrush>
                    <GradientStop x:Name="OrbGlowCenter" Color="#90C78B78" Offset="0"/>
                    <GradientStop x:Name="OrbGlowMid" Color="#40C78B78" Offset="0.58"/>
                    <GradientStop x:Name="OrbGlowEdge" Color="#00C78B78" Offset="1"/>
                </RadialGradientBrush>
            </Ellipse.Fill>
            <Ellipse.RenderTransform>
                <ScaleTransform x:Name="GlowScale" ScaleX="1" ScaleY="1"/>
            </Ellipse.RenderTransform>
        </Ellipse>
        <Ellipse x:Name="OrbCore" Width="168" Height="168"
                 Canvas.Left="71" Canvas.Top="71" Opacity="1"
                 RenderTransformOrigin="0.5,0.5" IsHitTestVisible="False">
            <Ellipse.Fill>
                <RadialGradientBrush>
                    <GradientStop Color="{DynamicResource OrbCoreCenterColor}" Offset="0"/>
                    <GradientStop Color="{DynamicResource OrbCoreMiddleColor}" Offset="0.8"/>
                    <GradientStop Color="{DynamicResource OrbCoreEdgeColor}" Offset="1"/>
                </RadialGradientBrush>
            </Ellipse.Fill>
            <Ellipse.RenderTransform>
                <ScaleTransform x:Name="CoreScale" ScaleX="1" ScaleY="1"/>
            </Ellipse.RenderTransform>
        </Ellipse>
        <Canvas x:Name="RainbowWashCanvas" Width="168" Height="168"
                Canvas.Left="71" Canvas.Top="71" Opacity="0.72"
                RenderTransformOrigin="0.5,0.5" IsHitTestVisible="False">
            <Canvas.Clip>
                <EllipseGeometry Center="84,84" RadiusX="84" RadiusY="84"/>
            </Canvas.Clip>
            <Canvas.RenderTransform>
                <TransformGroup>
                    <ScaleTransform x:Name="RainbowWashScale" ScaleX="1" ScaleY="1"/>
                    <RotateTransform x:Name="RainbowWashRotation"/>
                </TransformGroup>
            </Canvas.RenderTransform>
        </Canvas>
        <StackPanel Width="148" Canvas.Left="81" Canvas.Top="132"
                    IsHitTestVisible="False">
            <TextBlock x:Name="CenterLabel" Text="Balanced"
                       Foreground="{DynamicResource TextPrimaryBrush}" FontSize="22"
                       FontWeight="SemiBold" TextAlignment="Center"/>
            <TextBlock x:Name="LevelCaption" Text="50"
                       Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11"
                       Margin="0,5,0,0" TextAlignment="Center"/>
        </StackPanel>
        <TextBlock Text="Noise" Foreground="{DynamicResource TextMutedBrush}" FontSize="11"
                   Canvas.Left="60" Canvas.Top="7" IsHitTestVisible="False"/>
        <TextBlock Text="Awareness" Foreground="{DynamicResource TextMutedBrush}" FontSize="11"
                   Canvas.Right="39" Canvas.Top="7" IsHitTestVisible="False"/>
    </Canvas>
</UserControl>
