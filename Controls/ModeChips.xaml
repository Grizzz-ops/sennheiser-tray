<UserControl x:Class="SennheiserTray.ModeChips"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
    </UserControl.Resources>
    <ItemsControl ItemsSource="{Binding ModeChipItems}">
        <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
                <UniformGrid Columns="5" Rows="1"/>
            </ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
            <DataTemplate>
                <Grid>
                    <ToggleButton Style="{StaticResource ModeChipStyle}"
                                  IsChecked="{Binding IsSelected, Mode=OneWay}"
                                  Command="{Binding DataContext.SelectModeCommand, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"
                                  CommandParameter="{Binding Id}"
                                  AutomationProperties.Name="{Binding Name}">
                        <StackPanel>
                            <TextBlock Text="{Binding Icon}" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                       FontSize="16" HorizontalAlignment="Center"/>
                            <TextBlock Text="{Binding Name}" FontSize="10" HorizontalAlignment="Center"/>
                        </StackPanel>
                    </ToggleButton>
                    <Button Grid.ZIndex="1" Width="18" Height="18" Padding="0"
                            HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,0,1,1"
                            Content="&#xE840;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                            Style="{StaticResource ModePinButtonStyle}"
                            Visibility="{Binding IsSelected, Converter={StaticResource BooleanToVisibilityConverter}}"
                            ToolTip="{Binding DataContext.ModePinText, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"
                            Command="{Binding DataContext.ToggleModePinCommand, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"
                            AutomationProperties.Name="{Binding DataContext.ModePinActionText, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"/>
                </Grid>
            </DataTemplate>
        </ItemsControl.ItemTemplate>
    </ItemsControl>
</UserControl>
